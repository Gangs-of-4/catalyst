# Copy to .env and fill in values from the team. Names only here — never commit values.

# --- Demo build (ADR-0035) — this is all the demo needs ---
# Public https URL of the Cloudflare quick tunnel, e.g. https://xxxx.trycloudflare.com
PUBLIC_URL=
# The web app's public URL (Vercel), used in WhatsApp replies such as the sign-up link.
PUBLIC_APP_URL=
# Vapi dashboard → API Keys. Private key: server side only. Public key: used by the web call button.
VAPI_PRIVATE_KEY=
VAPI_PUBLIC_KEY=
# Web-call caps for the public test pages, per IST day (contracts.md section 1.10). No Vapi budget.
DEMO_CALLS_PER_DAY=20
CALLS_PER_BUSINESS_PER_DAY=10
# Written by scripts/setup_vapi.py — leave empty on first run.
VAPI_ASSISTANT_ID=
CATALYST_TOOL_SECRET=
# Phase 2 accounts: secret that signs the login cookie. Any long random string. Required with
# DATABASE_URL (the backend refuses to start without it); for local SQLite dev, if empty, one is
# generated into .env at startup. Never reuse it elsewhere.
SESSION_SECRET=
# Hard cap on one voice call, in seconds (default 180; there is no Vapi budget, contracts.md §1.10).
VAPI_MAX_CALL_SECONDS=
# Owner login for the demo clinic's desk and settings (at least 8 characters). Empty = no demo login;
# the desk and settings always need a login. Changing it changes the password on the next start.
DEMO_LOGIN_PASSWORD=
# Our team's admin page (usage evidence, feedback log). Empty = no admin login.
ADMIN_PASSWORD=
# Email for that login. Default: demo.clinic@example.com
DEMO_LOGIN_EMAIL=
# Email for the demo wholesale distributor's login (same password). Default: demo.wholesale@example.com
DEMO_WHOLESALE_LOGIN_EMAIL=
# 1 = at startup, give both demo businesses 4 weeks of fictional history (once). Set it on the
# deployed host; `python scripts/seed_demo.py` resets and re-seeds it, anchored to today.
DEMO_HISTORY=
# Comma-separated browser origins allowed to call the API cross-origin, e.g. https://<project>.vercel.app (ADR-0036).
# Empty = no CORS headers (same-origin only, as when FastAPI serves the pages locally).
CORS_ALLOWED_ORIGINS=
# NEXT_PUBLIC_API_URL is NOT set here: it lives in the Vercel project's Production environment variables.
# Twilio console → Account Info, and the WhatsApp sandbox "From" number (e.g. whatsapp:+14155238886).
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=
# Optional: Groq key for LLM parsing of WhatsApp commands the rules don't understand.
GROQ_API_KEY=
GROQ_MODEL=
# Optional overrides for the Vapi assistant (defaults: openai gpt-4.1-mini, azure hi-IN voice, deepgram nova-3 multi).
VAPI_MODEL_PROVIDER=
VAPI_MODEL=
VAPI_VOICE_PROVIDER=
VAPI_VOICE_ID=
VAPI_TRANSCRIBER_PROVIDER=
VAPI_TRANSCRIBER_MODEL=
VAPI_TRANSCRIBER_LANGUAGE=

# --- Core [MVP] ---
# Postgres URL (Neon in production, ADR-0039). Empty = SQLite file backend/data/clinic.db.
# Tests ignore it; set TEST_DATABASE_URL to a throwaway database to run tests on Postgres.
DATABASE_URL=
JWT_SECRET=
APP_ENV=local

# --- Agent tools API / custom-LLM endpoint [MVP] ---
TOOLS_API_KEY=

# --- LLM [MVP] (provider per D1; keep whichever applies) ---
CEREBRAS_API_KEY=
GEMINI_API_KEY=

# --- Voice platform [MVP if ADR-0029 is accepted] ---
RETELL_API_KEY=

# --- Telephony [MVP, provider per spike S1 / D2] ---
EXOTEL_API_KEY=
EXOTEL_API_TOKEN=
EXOTEL_SID=

# --- WhatsApp Business Platform [MVP] ---
WHATSAPP_CLOUD_API_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=

# --- Jobs (per D7) ---
REDIS_URL=

# --- Self-hosted speech [only on the Pipecat path] ---
SARVAM_API_KEY=
ELEVENLABS_API_KEY=

# --- Post-MVP ---
CLOUDFLARE_R2_ACCESS_KEY_ID=
CLOUDFLARE_R2_SECRET_ACCESS_KEY=
CLOUDFLARE_R2_BUCKET=
LANGFUSE_HOST=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
SENTRY_DSN=
POSTHOG_API_KEY=
